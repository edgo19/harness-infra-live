{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "revision_label", "schedules"],
  "properties": {
    "schema": {"const": "ScheduleRegistry/v1"},
    "revision_label": {"type": "string", "pattern": "^[a-zA-Z0-9-]{1,80}$"},
    "schedules": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "enabled", "cron", "time_zone", "missed_run_grace", "overlap_policy", "misfire_policy", "task_template"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,79}$"},
        "enabled": {"type": "boolean"},
        "cron": {"type": "string", "pattern": "^([*]|[0-5]?[0-9]|\\*/([1-9]|[1-5][0-9])) \\* \\* \\* \\*$"},
        "time_zone": {"const": "UTC"},
        "missed_run_grace": {"type": "string", "pattern": "^([1-9]|[1-5][0-9])m$"},
        "overlap_policy": {"const": "forbid"},
        "misfire_policy": {"const": "latest-eligible-only"},
        "task_template": {
          "type": "object", "additionalProperties": false,
          "required": ["capability", "goal", "parameters", "requested_limits", "outputs"],
          "properties": {"capability": {"type": "string"}, "goal": {"type": "string"}, "parameters": {"type": "object"}, "requested_limits": {"type": "object"}, "outputs": {"type": "object"}}
        }
      }
    }}
  }
}
