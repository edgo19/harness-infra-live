{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "request_id", "capability", "goal", "parameters", "requested_limits", "outputs"],
  "properties": {
    "schema": {"const": "TaskRequest/v1"},
    "request_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,79}$"},
    "capability": {"type": "string", "pattern": "^[a-z][a-z0-9-]+@[a-zA-Z0-9.+-]+$"},
    "goal": {"type": "string", "minLength": 1, "maxLength": 8192},
    "parameters": {"type": "object", "maxProperties": 32},
    "requested_limits": {
      "type": "object", "additionalProperties": false,
      "required": ["model_calls", "backend_query_calls", "retrieved_bytes", "wall_seconds"],
      "properties": {
        "model_calls": {"type": "integer", "minimum": 1, "maximum": 20},
        "backend_query_calls": {"type": "integer", "minimum": 1, "maximum": 30},
        "retrieved_bytes": {"type": "integer", "minimum": 1, "maximum": 20971520},
        "wall_seconds": {"type": "integer", "minimum": 1, "maximum": 1800}
      }
    },
    "outputs": {
      "type": "object", "additionalProperties": false,
      "required": ["formats", "destination"],
      "properties": {
        "formats": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["json", "markdown"]}},
        "destination": {"const": "configured-gcs-reports"}
      }
    }
  }
}
